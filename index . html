/* DRAWING CANVAS */
let isDrawing = false, drawCtx = null, drawCanvas = null;
function initDrawCanvas() {
  drawCanvas = document.getElementById('heartDrawCanvas');
  if (!drawCanvas) return;
  drawCtx = drawCanvas.getContext('2d');
  drawCtx.strokeStyle = '#f6d69b';
  drawCtx.lineWidth = 3.5;
  drawCtx.lineCap = 'round';

  function getPos(e) {
    const rect = drawCanvas.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    return { x: clientX - rect.left, y: clientY - rect.top };
  }

  drawCanvas.addEventListener('mousedown', e => { isDrawing = true; const p = getPos(e); drawCtx.beginPath(); drawCtx.moveTo(p.x, p.y); });
  window.addEventListener('mouseup', () => isDrawing = false);
  drawCanvas.addEventListener('mousemove', e => { if (!isDrawing) return; const p = getPos(e); drawCtx.lineTo(p.x, p.y); drawCtx.stroke(); });

  drawCanvas.addEventListener('touchstart', e => { isDrawing = true; const p = getPos(e); drawCtx.beginPath(); drawCtx.moveTo(p.x, p.y); });
  window.addEventListener('touchend', () => isDrawing = false);
  drawCanvas.addEventListener('touchmove', e => { if (!isDrawing) return; const p = getPos(e); drawCtx.lineTo(p.x, p.y); drawCtx.stroke(); });
}

function clearDrawCanvas() {
  if (drawCtx) drawCtx.clearRect(0, 0, drawCanvas.width, drawCanvas.height);
}

