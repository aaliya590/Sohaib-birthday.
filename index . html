<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#060107">
<title>Happy Birthday • Aaliya ❤️ Sohaib</title>

<!-- Romantic Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Alex+Brush&display=swap" rel="stylesheet">

<style>
:root {
  --bg-deep: #050106;
  --bg-wine: #1c0512;
  --wine-mid: #380b22;
  --wine-bright: #68123c;
  --gold: #f6d69b;
  --gold-bright: #fff3c9;
  --rose: #ff9eb6;
  --rose-glow: #ff5080;
  --cream: #fff9f4;
  --muted: #e2cadb;
  --glass-panel: rgba(38, 8, 26, 0.88);
  --border-line: rgba(246, 214, 155, 0.32);
  --border-glow: rgba(255, 158, 182, 0.45);
}

body.theme-pink {
  --bg-deep: #14030e;
  --bg-wine: #2d0a1e;
  --wine-mid: #4a0f30;
  --wine-bright: #8a1d52;
  --gold: #ffe1a8;
  --rose: #ffb3c6;
  --rose-glow: #ff3366;
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html { scroll-behavior: smooth; background: var(--bg-deep); }
body {
  min-height: 100vh;
  overflow-x: hidden;
  color: var(--cream);
  font-family: 'Montserrat', sans-serif;
  background: radial-gradient(ellipse at 50% 0%, #580d31 0%, #200414 45%, var(--bg-deep) 90%);
  background-attachment: fixed;
  line-height: 1.8;
  letter-spacing: 0.3px;
  user-select: none;
}

/* ROMANTIC GLOWING AURORA LIGHTS */
.ambient-glow-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(85px);
  pointer-events: none;
  z-index: 1;
  opacity: 0.45;
  animation: pulseGlow 12s infinite alternate ease-in-out;
}
.orb-1 { width: 420px; height: 420px; background: #92134b; top: -100px; left: -100px; }
.orb-2 { width: 480px; height: 480px; background: #5c0f3c; bottom: 10%; right: -120px; animation-delay: -4s; }

@keyframes pulseGlow {
  0% { transform: scale(1) translate(0, 0); opacity: 0.35; }
  50% { transform: scale(1.18) translate(30px, 40px); opacity: 0.55; }
  100% { transform: scale(0.92) translate(-20px, 20px); opacity: 0.4; }
}

/* TYPOGRAPHY */
h1, h2, h3, .serif { font-family: 'Playfair Display', Georgia, serif; }
.script { font-family: 'Great Vibes', cursive; color: var(--gold); }
.kicker {
  font-size: 0.76rem;
  letter-spacing: 3.5px;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 12px;
  display: inline-block;
  font-weight: 600;
  text-shadow: 0 0 12px rgba(246, 214, 155, 0.4);
}
.gold { color: var(--gold); }
.rose { color: var(--rose); }

/* PARTICLES */
#starsCanvas, #fxCanvas, .petals-container {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
#starsCanvas { z-index: 2; }
.petals-container { z-index: 80; overflow: hidden; }
#fxCanvas { z-index: 95; }

.petal {
  position: absolute;
  top: -50px;
  animation: petalFall linear forwards;
  opacity: 0.9;
  filter: drop-shadow(0 0 8px rgba(255, 80, 128, 0.5));
}
@keyframes petalFall { to { transform: translate3d(var(--drift), 115vh, 0) rotate(720deg); opacity: 0; } }

/* BUTTONS */
button, input, textarea { font: inherit; outline: none; }
button { cursor: pointer; }
.btn-primary {
  border: 1px solid var(--gold);
  background: linear-gradient(135deg, #8a1543 0%, #460924 50%, #1e0310 100%);
  color: var(--gold-bright);
  padding: 13px 32px;
  border-radius: 50px;
  font-size: 0.92rem;
  font-weight: 600;
  letter-spacing: 1px;
  box-shadow: 0 0 25px rgba(246, 214, 155, 0.28), 0 8px 24px rgba(0,0,0,0.5), inset 0 0 15px rgba(255, 158, 182, 0.25);
  transition: all 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  margin: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.btn-primary:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 0 35px rgba(246, 214, 155, 0.6), inset 0 0 22px rgba(255, 158, 182, 0.45);
}
.btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  color: var(--gold);
  border: 1px solid var(--border-line);
  padding: 11px 22px;
  border-radius: 50px;
  font-size: 0.84rem;
  transition: 0.3s;
  margin: 5px;
  backdrop-filter: blur(10px);
}
.btn-secondary:hover { background: rgba(255, 255, 255, 0.18); border-color: var(--gold); transform: translateY(-2px); }

/* GLASS PANELS */
.glass-panel {
  background: var(--glass-panel);
  border: 1px solid var(--border-line);
  border-radius: 28px;
  padding: 36px 24px;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.75), 0 0 30px rgba(104, 18, 60, 0.25), inset 0 0 35px rgba(246, 214, 155, 0.05);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  position: relative;
  overflow: hidden;
}

/* PROLOGUE */
.prologue-screen {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 25px;
  text-align: center;
  position: fixed;
  inset: 0;
  z-index: 500;
  background: radial-gradient(circle at center, #2e061b 0%, #050106 80%);
  transition: opacity 0.8s ease;
}
.prologue-box { width: min(650px, 100%); animation: fadeIn 1.5s ease; }
.name-input-field {
  width: min(320px, 90%);
  padding: 14px 20px;
  border-radius: 30px;
  border: 2px solid var(--gold);
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  text-align: center;
  font-size: 1.1rem;
  letter-spacing: 2px;
  margin: 15px 0;
  text-transform: uppercase;
  box-shadow: 0 0 20px rgba(246, 214, 155, 0.2);
}
.mood-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin: 20px 0;
}
.mood-card {
  padding: 14px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-line);
  border-radius: 16px;
  cursor: pointer;
  transition: 0.3s;
}
.mood-card.active, .mood-card:hover {
  border-color: var(--gold);
  background: linear-gradient(135deg, rgba(255,80,128,0.25), rgba(246,214,155,0.15));
  box-shadow: 0 0 18px rgba(255, 80, 128, 0.3);
}

/* MAIN APP */
#mainApp { display: none; }
.top-header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 120;
  padding: 10px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(6, 1, 7, 0.94);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-line);
}
.top-header-left { display: flex; flex-direction: column; align-items: flex-start; }
.top-header-title { font-family: 'Great Vibes', cursive; font-size: 1.7rem; color: var(--gold); line-height: 1; }
.track-ticker { font-size: 0.68rem; color: var(--rose); letter-spacing: 1px; margin-top: 3px; }
.header-actions { display: flex; align-items: center; gap: 8px; }
.header-btn {
  width: 38px; height: 38px;
  border-radius: 50%;
  border: 1px solid var(--gold);
  background: rgba(255, 255, 255, 0.08);
  color: var(--gold);
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem;
}
.scroll-progress {
  position: fixed;
  top: 62px; left: 0;
  height: 3px; width: 0;
  background: linear-gradient(90deg, var(--rose-glow), var(--gold));
  z-index: 121;
}

section {
  min-height: 92vh;
  padding: 95px 18px 70px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  z-index: 5;
}
.container { width: min(880px, 100%); text-align: center; }

/* AUDIO PLAYER AT THE START */
.media-player-card {
  margin: 15px auto 25px; max-width: 620px;
  background: radial-gradient(circle at center, #420a2a, #15020e);
  border: 2px solid var(--gold); border-radius: 28px;
  padding: 28px 22px; box-shadow: 0 0 55px rgba(255, 80, 128, 0.45), inset 0 0 25px rgba(246, 214, 155, 0.12);
}
.audio-visualizer {
  display: flex; justify-content: center; align-items: flex-end;
  gap: 6px; height: 42px; margin: 15px 0 20px;
}
.eq-bar {
  width: 6px; background: linear-gradient(to top, var(--rose-glow), var(--gold));
  border-radius: 6px; height: 8px; transition: height 0.2s ease;
}
.eq-bar.playing { animation: eqAnim 0.75s infinite alternate ease-in-out; }
.eq-bar:nth-child(2) { animation-delay: 0.12s; }
.eq-bar:nth-child(3) { animation-delay: 0.25s; }
.eq-bar:nth-child(4) { animation-delay: 0.38s; }
.eq-bar:nth-child(5) { animation-delay: 0.18s; }
.eq-bar:nth-child(6) { animation-delay: 0.32s; }
.eq-bar:nth-child(7) { animation-delay: 0.45s; }
@keyframes eqAnim { 0% { height: 6px; } 100% { height: 38px; } }

.audio-player-wrap { margin: 15px 0; display: flex; justify-content: center; }
.audio-player-wrap audio { width: 100%; max-width: 480px; border-radius: 30px; outline: none; }

/* 3D CUBE */
.cube-wrap { width: 200px; height: 200px; margin: 38px auto; perspective: 1000px; }
.photo-cube {
  width: 100%; height: 100%; position: relative;
  transform-style: preserve-3d; animation: rotateCube 16s infinite linear;
}
.cube-face {
  position: absolute; width: 200px; height: 200px;
  border: 2px solid var(--gold); border-radius: 18px;
  background: #180310; overflow: hidden; box-shadow: 0 0 35px rgba(0,0,0,0.8);
}
.cube-face img { width: 100%; height: 100%; object-fit: cover; }
.cube-face.front  { transform: rotateY(0deg) translateZ(100px); }
.cube-face.back   { transform: rotateY(180deg) translateZ(100px); }
.cube-face.right  { transform: rotateY(90deg) translateZ(100px); }
.cube-face.left   { transform: rotateY(-90deg) translateZ(100px); }
.cube-face.top    { transform: rotateX(90deg) translateZ(100px); }
.cube-face.bottom { transform: rotateX(-90deg) translateZ(100px); }
@keyframes rotateCube { to { transform: rotateX(360deg) rotateY(360deg); } }

/* POLAROID GALLERY */
.memory-grid { display: grid; grid-template-columns: 1fr; gap: 28px; margin-top: 25px; }
.polaroid {
  background: linear-gradient(145deg, #1f0616 0%, #11020c 100%);
  border: 1px solid var(--border-line);
  padding: 16px 16px 22px;
  border-radius: 24px;
  box-shadow: 0 18px 50px rgba(0,0,0,0.65);
  transition: transform 0.35s ease, border-color 0.35s;
  cursor: pointer; text-align: left;
}
.polaroid:hover { transform: translateY(-6px); border-color: var(--gold); }
.polaroid-img-box {
  width: 100%; height: 480px; border-radius: 18px;
  overflow: hidden; background: #080107; display: flex;
  align-items: center; justify-content: center; position: relative;
}
.polaroid-img-box img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.5s ease;
}
.polaroid:hover .polaroid-img-box img { transform: scale(1.03); }
.polaroid-caption { padding: 16px 8px 0; }
.polaroid-caption h4 { color: var(--gold); font-size: 1.18rem; }
.polaroid-caption p { color: var(--muted); font-size: 0.9rem; margin-top: 5px; line-height: 1.6; }

/* CAKE & CANDLE */
.cake-stage { position: relative; width: 220px; height: 190px; margin: 30px auto 15px; cursor: pointer; }
.cake-base {
  position: absolute; bottom: 0; left: 10px; width: 200px; height: 85px;
  background: linear-gradient(135deg, #7c143d, #38071c);
  border-radius: 18px 18px 8px 8px; border: 2px solid var(--gold);
}
.cake-top-tier {
  position: absolute; bottom: 80px; left: 35px; width: 150px; height: 60px;
  background: linear-gradient(135deg, #991c4d, #4e0b29);
  border-radius: 14px 14px 8px 8px; border: 2px solid var(--gold);
}
.cake-candle {
  position: absolute; bottom: 138px; left: 103px; width: 14px; height: 42px;
  background: repeating-linear-gradient(45deg, #fff, #fff 5px, #f5d496 5px, #f5d496 10px);
  border-radius: 4px;
}
.candle-flame {
  position: absolute; bottom: 180px; left: 100px; width: 20px; height: 28px;
  background: radial-gradient(circle, #fff, #ffd200 40%, #ff4500 80%);
  border-radius: 50% 50% 20% 20%;
  animation: flicker 0.8s infinite alternate ease-in-out;
  box-shadow: 0 0 28px #ffd200; transition: 0.5s;
}
.candle-flame.blown { opacity: 0; transform: scale(0) translateY(-20px); }
@keyframes flicker { to { transform: scale(1.15) rotate(2deg); } }

/* COUNTDOWN & SCAVENGER */
.scavenger-bar {
  background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-line);
  padding: 8px 18px; border-radius: 30px; margin-bottom: 25px;
  display: inline-flex; align-items: center; gap: 12px; font-size: 0.82rem;
}
.secret-heart { cursor: pointer; transition: 0.3s; opacity: 0.7; }
.secret-heart.found { opacity: 1; filter: drop-shadow(0 0 10px var(--rose-glow)); transform: scale(1.25); }

.countdown-grid { display: flex; justify-content: center; gap: 12px; margin: 25px 0 15px; flex-wrap: wrap; }
.countdown-slot {
  min-width: 80px; padding: 14px 10px; border-radius: 20px;
  background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-line);
}
.countdown-slot b { display: block; font-size: 1.7rem; color: var(--gold); font-family: 'Playfair Display', serif; }
.countdown-slot small { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; }

/* BALLOON MINI GAME */
.balloon-grid { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin: 25px 0; }
.balloon-item {
  width: 65px; height: 80px; border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
  background: linear-gradient(135deg, #ff5080, #7c143d);
  border: 1px solid var(--gold); display: flex; align-items: center; justify-content: center;
  font-size: 1.4rem; cursor: pointer; transition: transform 0.2s; position: relative;
}
.balloon-item::after {
  content: ''; position: absolute; bottom: -8px; left: 50%;
  transform: translateX(-50%); width: 2px; height: 10px; background: var(--gold);
}
.balloon-item.popped { transform: scale(0); opacity: 0; pointer-events: none; }

/* DRAW CANVAS */
#heartDrawCanvas {
  width: 100%; max-width: 440px; height: 220px;
  background: #11030d; border: 1px dashed var(--gold);
  border-radius: 18px; margin: 15px auto; display: block;
  touch-action: none; cursor: crosshair;
}

/* 5-LEVEL LOCK */
.lock-stages-box { display: flex; justify-content: center; gap: 8px; margin: 20px 0; }
.lock-stage-dot {
  width: 34px; height: 34px; border-radius: 50%;
  border: 1px solid var(--gold); display: flex; align-items: center;
  justify-content: center; font-size: 0.85rem; background: rgba(255,255,255,0.05);
}
.lock-stage-dot.unlocked { background: var(--rose-glow); color: white; box-shadow: 0 0 12px var(--rose-glow); }

/* MERGE HEARTS */
.merge-hearts-wrap { display: flex; justify-content: center; align-items: center; gap: 40px; margin: 30px auto; min-height: 90px; }
.float-heart-node { font-size: 45px; transition: transform 1.5s ease; }
.merge-hearts-wrap.merged .h1 { transform: translateX(25px) scale(1.3); }
.merge-hearts-wrap.merged .h2 { transform: translateX(-25px) scale(1.3); }

/* DUA ROAD */
.future-road-box { text-align: left; border-left: 2px dashed var(--gold); margin: 25px auto; padding-left: 24px; max-width: 540px; }
.future-step { position: relative; margin-bottom: 22px; }
.future-step::before { content: '🌸'; position: absolute; left: -34px; top: 0; background: var(--bg-deep); }

/* QUIZ */
.quiz-options { display: grid; gap: 10px; margin: 20px 0; }
.quiz-btn {
  padding: 14px 18px; border-radius: 16px;
  border: 1px solid var(--border-line); background: rgba(255, 255, 255, 0.05);
  color: var(--cream); text-align: left; transition: all 0.25s ease; font-size: 0.92rem;
}
.quiz-btn:hover { border-color: var(--gold); background: rgba(255, 255, 255, 0.12); transform: translateX(4px); }
.meter-track { height: 22px; border-radius: 30px; background: rgba(255, 255, 255, 0.06); border: 1px solid var(--border-line); padding: 2px; margin: 20px 0 10px; }
.meter-fill-bar { height: 100%; width: 0%; border-radius: 30px; background: linear-gradient(90deg, #ff5080, #f6d69b); transition: width 1.2s cubic-bezier(0.2, 0.8, 0.2, 1); }

/* BOTTOM DOCK */
.bottom-dock {
  position: fixed; bottom: 12px; left: 50%; transform: translateX(-50%);
  z-index: 120; width: min(94%, 620px); display: flex; justify-content: space-around;
  padding: 8px; border-radius: 30px; background: rgba(14, 3, 11, 0.94);
  backdrop-filter: blur(20px); border: 1px solid var(--border-line);
}
.bottom-dock button { background: none; border: none; color: var(--muted); font-size: 0.65rem; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 4px 6px; }
.bottom-dock button span { font-size: 1.15rem; }
.bottom-dock button:hover, .bottom-dock button.active { color: var(--gold); }

/* POPUP MODAL & TOAST */
.modal-overlay { position: fixed; inset: 0; background: rgba(3, 1, 4, 0.95); z-index: 600; display: none; align-items: center; justify-content: center; padding: 18px; }
.modal-overlay.active { display: flex; animation: fadeIn 0.3s; }
.modal-box { width: min(580px, 100%); background: var(--wine-mid); border: 1px solid var(--gold); border-radius: 24px; padding: 24px 18px; text-align: center; position: relative; max-height: 90vh; overflow-y: auto; }
.modal-close { position: absolute; top: 10px; right: 16px; font-size: 28px; color: var(--gold); cursor: pointer; }

#toast {
  position: fixed; left: 50%; top: 78px; transform: translateX(-50%) scale(0.9);
  z-index: 700; background: rgba(28, 6, 18, 0.96); border: 1px solid var(--gold);
  padding: 10px 24px; border-radius: 50px; color: var(--gold-bright); font-size: 0.88rem;
  opacity: 0; pointer-events: none; transition: all 0.3s ease; text-align: center;
}
#toast.show { opacity: 1; transform: translateX(-50%) scale(1); }

@keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

@media(min-width: 700px) {
  .memory-grid { grid-template-columns: repeat(2, 1fr); }
}
</style>
</head>
<body>

<div class="ambient-glow-orb orb-1"></div>
<div class="ambient-glow-orb orb-2"></div>

<canvas id="starsCanvas"></canvas>
<canvas id="fxCanvas"></canvas>
<div class="petals-container" id="petals"></div>
<div id="toast"></div>

<!-- STAGE 0: PROLOGUE / NAME ENTRY -->
<div class="prologue-screen" id="prologueScreen">
  <div class="prologue-box glass-panel">
    <div style="font-size: 48px; animation: float 3s infinite ease-in-out;">🌙✨</div>
    <span class="kicker">Bismillah-ir-Rahman-ir-Rahim • Aaliya & Sohaib</span>
    
    <h1 class="serif" style="color: var(--gold-bright); font-size: clamp(1.6rem, 5vw, 2.3rem); margin: 10px 0;">
      Assalamu Alaikum Wa Rahmatullahi Wa Barakatuhu ❤️
    </h1>
    <p style="color: var(--muted); font-size: 0.92rem; max-width: 480px; margin: 0 auto 15px;">
      Someone made this little universe purely for your special birthday. Please enter your name to begin the journey with your special song:
    </p>

    <input type="text" id="nameAuthInput" class="name-input-field" placeholder="TYPE: SOHAIB" autocomplete="off">
    <br>
    
    <div style="max-width: 440px; margin: 10px auto;">
      <small class="gold" style="letter-spacing: 1px;">CHOOSE OUR STARTING MOOD:</small>
      <div class="mood-grid">
        <div class="mood-card active" onclick="setMood('romantic', this)">❤️ Romantic Peace</div>
        <div class="mood-card" onclick="setMood('emotional', this)">🥺 Soulful Lofi</div>
        <div class="mood-card" onclick="setMood('dreamy', this)">🌙 Dreamy Ambient</div>
        <div class="mood-card" onclick="setMood('birthday', this)">🎂 Birthday Joy</div>
      </div>
    </div>

    <button class="btn-primary" onclick="validateAndEnter()">
      <span>🔐 Enter My Heart & Play Song 🎵</span>
    </button>
  </div>
</div>

<!-- MAIN APPLICATION -->
<div id="mainApp">
  <!-- Top Navigation -->
  <div class="top-header">
    <div class="top-header-left">
      <div class="top-header-title">Aaliya ❤️ Sohaib</div>
      <div class="track-ticker" id="currentTrackDisplay">🎵 Playing: Tum Hi Ho (Dedicated)</div>
    </div>
    <div class="header-actions">
      <button class="header-btn" onclick="toggleTheme()" title="Toggle Theme">🌗</button>
      <button class="header-btn" id="audioToggleBtn" onclick="toggleAudioEngine()" title="Music Mute/Unmute">🔊</button>
    </div>
  </div>
  <div id="scrollProgress" class="scroll-progress"></div>

  <!-- CHAPTER 01: DEDICATED SONG THEATER (AT THE VERY START) -->
  <section id="songSection">
    <div class="container glass-panel">
      <div class="scavenger-bar">
        <span>Secret Hearts: <b id="foundCount" class="gold">0/5</b></span>
        <span>•</span>
        <span>Trophies: <b id="trophyCount" class="gold">0/4</b> 🏆</span>
