function runTypewriter(text, elId) {
  const el = document.getElementById(elId);
  if (!el) return;
  el.textContent = '';
  let i = 0;
  const timer = setInterval(() => {
    el.textContent += text.charAt(i);
    i++;
    if (i >= text.length) clearInterval(timer);
  }, 45);
}

/* SONG ENGINE */
const audioElem = document.getElementById('mainAudioTrack');
const eqBars = document.querySelectorAll('.eq-bar');

function setEqState(isPlaying) {
  eqBars.forEach(b => {
    if (isPlaying) b.classList.add('playing');
    else b.classList.remove('playing');
  });
}

function playDedicatedSong() {
  audioElem.volume = 1.0;
  audioElem.play().then(() => {
    setEqState(true);
    document.getElementById('audioToggleBtn').textContent = '🔊';
    document.getElementById('currentTrackDisplay').textContent = '🎵 Playing: Tum Hi Ho (Dedicated)';
    showToast('🎵 Playing "Tum Hi Ho" with full voice ❤️');
  }).catch(() => {
    showToast('Tap play directly on the audio controls! 🎶');
  });
}

function toggleAudioEngine() {
  const btn = document.getElementById('audioToggleBtn');
  if (!audioElem.paused) {
    audioElem.pause();
    btn.textContent = '🔇';
    setEqState(false);
    showToast('Song Muted / Paused 🔇');
  } else {
    audioElem.play();
    btn.textContent = '🔊';
    setEqState(true);
    showToast('Song Playing 🎵');
  }
}

audioElem.addEventListener('play', () => {
  setEqState(true);
  document.getElementById('audioToggleBtn').textContent = '🔊';
});

audioElem.addEventListener('pause', () => {
  setEqState(false);
  document.getElementById('audioToggleBtn').textContent = '🔇';
});

