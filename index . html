/* STARS & PARTICLES */
const starsCanvas = document.getElementById('starsCanvas');
const sCtx = starsCanvas.getContext('2d');
let stars = [];

function resizeStars() {
  starsCanvas.width = window.innerWidth;
  starsCanvas.height = window.innerHeight;
  stars = Array.from({ length: Math.min(110, Math.floor(window.innerWidth / 4.5)) }, () => ({
    x: Math.random() * starsCanvas.width,
    y: Math.random() * starsCanvas.height,
    radius: Math.random() * 1.4 + 0.3,
    alpha: Math.random(),
    speed: Math.random() * 0.02 + 0.005
  }));
}
window.addEventListener('resize', resizeStars);
resizeStars();

function drawStars() {
  sCtx.clearRect(0, 0, starsCanvas.width, starsCanvas.height);
  stars.forEach(s => {
    s.alpha += s.speed;
    if (s.alpha > 1) s.alpha = 0;
    sCtx.globalAlpha = 0.2 + 0.6 * Math.abs(Math.sin(s.alpha * Math.PI));
    sCtx.fillStyle = '#f6d69b';
    sCtx.beginPath();
    sCtx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
    sCtx.fill();
  });
  requestAnimationFrame(drawStars);
}
drawStars();

function triggerBurst(count = 35) {
  const fx = document.getElementById('fxCanvas');
  const ctx = fx.getContext('2d');
  fx.width = window.innerWidth;
  fx.height = window.innerHeight;

  let particles = [];
  const emojis = ['❤️', '✨', '🌹', '💖', '🎂', '🌸', '💍', '👑'];

  for (let i = 0; i < count; i++) {
    particles.push({
      x: fx.width / 2,
      y: fx.height * 0.55,
      vx: (Math.random() - 0.5) * 16,
      vy: (Math.random() - 0.85) * 16,
      gravity: 0.24,
      life: 60 + Math.random() * 40,
      char: emojis[Math.floor(Math.random() * emojis.length)]
    });
  }

  function loop() {
    ctx.clearRect(0, 0, fx.width, fx.height);
    particles.forEach(p => {
      p.x += p.vx; p.y += p.vy; p.vy += p.gravity; p.life--;
      ctx.font = '22px serif'; ctx.fillText(p.char, p.x, p.y);
    });
    particles = particles.filter(p => p.life > 0);
    if (particles.length > 0) requestAnimationFrame(loop);
    else ctx.clearRect(0, 0, fx.width, fx.height);
  }
  loop();
}

function spawnPetalShower(n = 15) {
  const container = document.getElementById('petals');
  const symbols = ['🌹', '🌸', '✨', '❤️', '🕊️'];
  for (let i = 0; i < n; i++) {
    const el = document.createElement('div');
    el.className = 'petal';
    el.textContent = symbols[Math.floor(Math.random() * symbols.length)];
    el.style.left = Math.random() * 100 + '%';
    el.style.fontSize = (16 + Math.random() * 14) + 'px';
    el.style.animationDuration = (4.5 + Math.random() * 4.5) + 's';
    el.style.setProperty('--drift', (Math.random() * 200 - 100) + 'px');
    container.appendChild(el);
    setTimeout(() => el.remove(), 9000);
  }
}
